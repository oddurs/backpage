#!/bin/sh
# One unit of work -> one worktree -> one branch -> one PR.
#
# Layout:
#   <repo>/                          primary checkout, always on the default branch
#   ../.worktrees/<repo>/<branch>/   one directory per branch, created and removed here
set -eu

BRANCH_RE='^(feat|fix|chore|docs|perf|refactor|test)/[a-z0-9][a-z0-9._-]*$'
COMMIT_RE='^(feat|fix|chore|docs|perf|refactor|test|build|ci|style|revert)(\([a-z0-9._/-]+\))?!?: .+'
ATTRIBUTION_RE='co-authored-by:[[:space:]]*(claude|anthropic)|generated with|claude code|written by (an )?ai|🤖'

info() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarn\033[0m %s\n' "$*" >&2; }
die() {
	printf '\033[31merror\033[0m %s\n' "$*" >&2
	exit 1
}

# Path of the primary checkout; the first entry of `git worktree list` always is.
main_root() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }

# Default branch, resolved from the remote rather than assumed.
default_branch() {
	# Each candidate is checked for emptiness: piping through sed would mask the
	# upstream failure, since sed exits 0 on empty input.
	ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
	if [ -n "$ref" ]; then
		printf '%s\n' "${ref#origin/}"
		return
	fi
	ref=$(git remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p' || true)
	if [ -n "$ref" ]; then
		printf '%s\n' "$ref"
		return
	fi
	printf 'main\n'
}

worktree_root() {
	root=$(main_root)
	printf '%s/.worktrees/%s' "$(dirname -- "$root")" "$(basename -- "$root")"
}

task() { "$(main_root)/scripts/task" "$@"; }

require_clean() {
	if ! git diff --quiet || ! git diff --cached --quiet; then
		die "working tree is dirty; commit or stash first"
	fi
}

cmd_doctor() {
	fail=0
	check() {
		if eval "$2" >/dev/null 2>&1; then
			printf '  \033[32mok\033[0m   %s\n' "$1"
		else
			printf '  \033[31mfail\033[0m %s\n     %s\n' "$1" "$3"
			fail=1
		fi
	}
	info "checking environment"
	check "git present" "command -v git" "install git"
	check "gh present" "command -v gh" "brew install gh"
	check "gh authenticated" "gh auth status" "run: gh auth login"
	check "cargo present" "command -v cargo" "install rustup"
	check "rustfmt present" "cargo fmt --version" "rustup component add rustfmt"
	check "clippy present" "cargo clippy --version" "rustup component add clippy"
	check "origin configured" "git remote get-url origin" "add an origin remote"
	# shellcheck disable=SC2016  # predicate is evaluated by check(), not here
	check "hooks path set" \
		'[ "$(git config core.hooksPath)" = .githooks ]' \
		"run: scripts/setup"
	check "hooks executable" '[ -x .githooks/pre-push ]' "run: scripts/setup"
	check "working tree clean" "git diff --quiet && git diff --cached --quiet" \
		"commit or stash your changes"
	[ "$fail" -eq 0 ] || die "doctor found problems"
	info "all good"
}

cmd_start() {
	branch=${1:-}
	[ -n "$branch" ] || die "usage: scripts/agent start <type>/<slug>"
	printf '%s' "$branch" | grep -Eq "$BRANCH_RE" ||
		die "branch must match $BRANCH_RE (e.g. feat/wallpaper-writer)"

	git show-ref --verify --quiet "refs/heads/$branch" &&
		die "branch $branch already exists; use 'scripts/agent list'"

	base=$(default_branch)
	dir="$(worktree_root)/$branch"
	[ -e "$dir" ] && die "$dir already exists"

	info "fetching origin"
	git fetch --quiet origin
	info "creating worktree for $branch from origin/$base"
	mkdir -p "$(dirname -- "$dir")"
	git worktree add -b "$branch" "$dir" "origin/$base" >/dev/null
	git -C "$dir" config core.hooksPath .githooks

	printf '\n  cd %s\n\n' "$dir"
}

cmd_check() { task check; }

cmd_commit() {
	msg=${1:-}
	[ -n "$msg" ] || die "usage: scripts/agent commit <message>"
	printf '%s' "$msg" | head -1 | grep -Eq "$COMMIT_RE" ||
		die "message must be a Conventional Commit (e.g. 'fix(render): pad short rows')"
	git commit -m "$msg"
}

cmd_sync() {
	base=$(default_branch)
	require_clean
	info "rebasing onto origin/$base"
	git fetch --quiet origin
	git rebase "origin/$base"
}

cmd_pr() {
	draft=""
	[ "${1:-}" = "--draft" ] && draft="--draft"

	branch=$(git rev-parse --abbrev-ref HEAD)
	base=$(default_branch)
	[ "$branch" = "$base" ] && die "refusing to open a PR from $base"
	require_clean

	info "running checks"
	task check

	if git log "origin/$base..HEAD" --format='%B' | grep -Eiq "$ATTRIBUTION_RE"; then
		die "commit messages contain attribution; rewrite them before opening a PR"
	fi

	info "pushing $branch"
	git push --quiet -u origin "$branch"
	info "opening pull request"
	# shellcheck disable=SC2086
	gh pr create --base "$base" --fill $draft
}

cmd_done() {
	branch=$(git rev-parse --abbrev-ref HEAD)
	base=$(default_branch)
	[ "$branch" = "$base" ] && die "nothing to finish; you are on $base"

	state=$(gh pr view "$branch" --json state --jq .state 2>/dev/null || echo NONE)
	[ "$state" = "MERGED" ] || die "PR for $branch is $state, not MERGED"

	root=$(main_root)
	dir=$(git rev-parse --show-toplevel)

	info "removing worktree $dir"
	cd "$root"
	git worktree remove --force "$dir"
	git branch -D "$branch" >/dev/null

	# A nested branch name like fix/foo leaves an empty parent directory behind.
	# rmdir refuses non-empty directories, so this stops at the first one that
	# still holds another worktree.
	parent=$(dirname -- "$dir")
	stop=$(worktree_root)
	while [ "$parent" != "$stop" ] && [ "$parent" != "/" ]; do
		rmdir "$parent" 2>/dev/null || break
		parent=$(dirname -- "$parent")
	done
	git worktree prune
	git fetch --quiet --prune origin
	git -C "$root" pull --quiet --ff-only

	printf '\n  cd %s\n\n' "$root"
}

cmd_list() {
	info "worktrees"
	git worktree list
	if command -v gh >/dev/null 2>&1; then
		printf '\n'
		info "pull requests"
		gh pr list --author "@me" 2>/dev/null || true
	fi
}

usage() {
	cat >&2 <<'USAGE'
usage: scripts/agent <command>

  doctor                verify the environment is ready
  start <type>/<slug>   create a branch and its worktree, print the path
  check                 run the full check suite
  commit <message>      validate the message, then commit
  sync                  rebase onto the default branch
  pr [--draft]          check, push, and open a pull request
  done                  after merge: remove the worktree and branch
  list                  worktrees and their pull requests

  types: feat fix chore docs perf refactor test
USAGE
}

case "${1:-}" in
doctor)
	shift
	cmd_doctor "$@"
	;;
start)
	shift
	cmd_start "$@"
	;;
check)
	shift
	cmd_check "$@"
	;;
commit)
	shift
	cmd_commit "$@"
	;;
sync)
	shift
	cmd_sync "$@"
	;;
pr)
	shift
	cmd_pr "$@"
	;;
done)
	shift
	cmd_done "$@"
	;;
list)
	shift
	cmd_list "$@"
	;;
*)
	usage
	exit 2
	;;
esac
